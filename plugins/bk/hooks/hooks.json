{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/bk-launch\" hook --host claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/bk-launch\" hook --host claude-code",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/bk-launch\" hook --host claude-code",
            "timeout": 10,
            "if": "Bash(git push*)"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/bk-launch\" hook --host claude-code",
            "timeout": 10,
            "if": "Bash(gh pr create*)"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/bk-launch\" hook --host claude-code",
            "timeout": 10,
            "if": "Bash(gh pr merge*)"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/bk-launch\" hook --host claude-code",
            "timeout": 10,
            "if": "PowerShell(git push*)"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/bk-launch\" hook --host claude-code",
            "timeout": 10,
            "if": "PowerShell(gh pr create*)"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/bk-launch\" hook --host claude-code",
            "timeout": 10,
            "if": "PowerShell(gh pr merge*)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/bk-launch\" hook --host claude-code",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
